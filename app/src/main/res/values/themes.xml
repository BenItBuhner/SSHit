<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Launch: the launcher's graphite with the monogram in the middle and nothing else. The splash
      background matches the adaptive icon's background, so the system's icon disc disappears into
      it and only the copper "BE" remains until the first frame of the Stage.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

    <!--
      The lock window (LockActivity): the app theme with no activity transition in either direction,
      so no frame of the shell shows through the lock's arrival or its departure.
    -->
    <style name="Theme.App.Lock" parent="Theme.App">
        <item name="android:windowAnimationStyle">@style/Animation.App.Lock</item>
    </style>

    <style name="Animation.App.Lock" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>
</resources>
